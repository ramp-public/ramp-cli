{
  "name": "@ramp/router-opencode-provider",
  "version": "0.0.0",
  "private": true,
  "description": "Native OpenCode provider for Ramp Router",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./server": "./index.ts",
    "./tui": "./tui.ts"
  },
  "files": [
    "index.ts",
    "tui.ts",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0",
    "opencode": ">=1.18.3 <3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test",
    "verify": "npm run typecheck && npm run test"
  },
  "keywords": [
    "opencode",
    "opencode-v2",
    "ramp-router",
    "llm",
    "provider",
    "openai-responses"
  ],
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.3 <2",
    "@opencode/plugin": ">=2.0.0 <3",
    "@opentui/core": ">=0.4.3",
    "@opentui/solid": ">=0.4.3",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.3",
    "@opencode/plugin": "2.0.15",
    "@opencode/theme": "2.0.15",
    "@opentui/core": "0.5.12",
    "@opentui/keymap": "0.5.12",
    "@opentui/solid": "0.5.12",
    "@types/node": "^24.0.0",
    "solid-js": "1.9.12",
    "typescript": "^6.0.0"
  }
}
