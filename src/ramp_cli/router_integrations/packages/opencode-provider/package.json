{
  "name": "@ramp/router-opencode-provider",
  "version": "0.0.0",
  "private": true,
  "description": "Native OpenCode provider for Ramp Router",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0",
    "opencode": ">=1.18.3 <2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test",
    "verify": "npm run typecheck && npm run test"
  },
  "keywords": [
    "opencode",
    "ramp-router",
    "llm",
    "provider",
    "openai-responses"
  ],
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.3 <2"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.3",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0"
  }
}
