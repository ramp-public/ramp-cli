{
  "name": "@ramp/cli",
  "version": "0.0.0",
  "nativeCliVersion": "0.0.0",
  "description": "Install and launch the standalone Ramp CLI",
  "license": "MIT",
  "engines": { "node": ">=22", "npm": ">=10" },
  "bin": { "ramp": "bin/ramp.js" },
